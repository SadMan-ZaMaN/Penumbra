<Window x:Class="Penumbra.NowPlayingScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Now playing · Penumbra" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        WindowStartupLocation="Manual" Background="#0c0818" Foreground="White"
        FontFamily="Segoe UI Variable Display, Segoe UI">
    <Grid>
        <!-- the cover, blurred and darkened, filling the screen -->
        <Image x:Name="Backdrop" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- everything else is laid out on a 1440 x 900 canvas (the screen at 200%) and scaled to fit -->
        <Viewbox Stretch="Uniform">
            <Canvas Width="1440" Height="900">
                <!-- left: the cover card (the right side, 740..1240 x 100..665, is where the lyrics go) -->
                <Border Canvas.Left="210" Canvas.Top="100" Width="380" Height="475" CornerRadius="20"
                        Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                    <StackPanel Margin="19">
                        <Grid Width="340" Height="340">
                            <Border x:Name="CoverBox" CornerRadius="13">
                                <Border.Background>
                                    <ImageBrush x:Name="Cover" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <TextBlock x:Name="CoverNote" Text="♪" FontSize="120" Opacity="0.55"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="SongTitle" Margin="1,20,0,0" FontSize="32" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SongArtist" Margin="2,2,0,0" FontSize="23" Opacity="0.72" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <TextBlock Canvas.Left="1310" Canvas.Top="35" Text="Esc to close" FontSize="15" FontWeight="SemiBold" Opacity="0.35"/>
            </Canvas>
        </Viewbox>
    </Grid>
</Window>
