<Window x:Class="LumnWin.ControlPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Penumbra" Width="340" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True"
        Background="#15151b" Foreground="#f0f0f5" BorderBrush="#33ffffff" BorderThickness="1"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#8b7bff"/>
        <SolidColorBrush x:Key="Card" Color="#1e1e26"/>
        <SolidColorBrush x:Key="Control" Color="#2a2a35"/>
        <SolidColorBrush x:Key="Subtle" Color="#9b9bab"/>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Subtle}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- pill-shaped choice buttons -->
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#f0f0f5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="7" Background="{StaticResource Control}" Padding="9,5" Margin="0,0,5,5">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#363644"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- on/off switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#f0f0f5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="track" Grid.Column="1" Width="40" Height="22" CornerRadius="11" Background="#3a3a46">
                                <Ellipse x:Name="knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- slider: thin track, filled part in the accent color, round white thumb -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24">
                            <Border Height="4" CornerRadius="2" Background="#3a3a46" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Background="{StaticResource Accent}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Background="Transparent" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- color swatch / preset button -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="#40ffffff" BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="14,12,14,12">

        <!-- header: name, on/off, now playing -->
        <Grid Margin="2,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Penumbra" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="NowPlaying" Text="Listening…" Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
            <CheckBox x:Name="Enabled" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,4,0,0"/>
        </Grid>

        <!-- colors -->
        <TextBlock Text="COLORS" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="LiveColors" Width="56" Height="22" CornerRadius="11" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ColorInfo" Grid.Column="1" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>

                <WrapPanel x:Name="SourceChoices">
                    <RadioButton Style="{StaticResource Seg}" GroupName="src" Tag="Auto" Content="Auto" ToolTip="Album art for music, the screen for videos"/>
                    <RadioButton Style="{StaticResource Seg}" GroupName="src" Tag="AlbumArt" Content="Album art"/>
                    <RadioButton Style="{StaticResource Seg}" GroupName="src" Tag="Screen" Content="Screen"/>
                    <RadioButton Style="{StaticResource Seg}" GroupName="src" Tag="Custom" Content="Mine" ToolTip="The two colors below"/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                    <TextBlock Text="Primary" Style="{StaticResource Label}"/>
                    <Button x:Name="PrimarySwatch" Style="{StaticResource Swatch}" Width="40" Height="24" Margin="0,0,16,0" ToolTip="Pick a color"/>
                    <TextBlock Text="Secondary" Style="{StaticResource Label}"/>
                    <Button x:Name="SecondarySwatch" Style="{StaticResource Swatch}" Width="40" Height="24" ToolTip="Pick a color"/>
                </StackPanel>
                <WrapPanel x:Name="Presets"/>
            </StackPanel>
        </Border>

        <!-- look -->
        <TextBlock Text="LOOK" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Thickness" Style="{StaticResource Label}"/>
                <Slider x:Name="Thickness" Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="20"/>
                <TextBlock Grid.Row="1" Text="Glow" Style="{StaticResource Label}"/>
                <Slider x:Name="Glow" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="120"/>
                <TextBlock Grid.Row="2" Text="Brightness" Style="{StaticResource Label}"/>
                <Slider x:Name="Brightness" Grid.Row="2" Grid.Column="1" Minimum="0.15" Maximum="1"/>
                <TextBlock Grid.Row="3" Text="Waviness" Style="{StaticResource Label}"/>
                <Slider x:Name="Waviness" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="2"/>
                <TextBlock Grid.Row="4" Text="Corners" Style="{StaticResource Label}" Margin="0,8,12,0" VerticalAlignment="Top"/>
                <WrapPanel x:Name="CornerChoices" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0">
                    <RadioButton Style="{StaticResource Seg}" GroupName="corners" Tag="0" Content="Square"/>
                    <RadioButton Style="{StaticResource Seg}" GroupName="corners" Tag="24" Content="Rounded"/>
                    <RadioButton Style="{StaticResource Seg}" GroupName="corners" Tag="60" Content="Round"/>
                </WrapPanel>
                <TextBlock Grid.Row="5" Text="Motion" Style="{StaticResource Label}" Margin="0,2,12,0" VerticalAlignment="Top"/>
                <WrapPanel x:Name="ModeChoices" Grid.Row="5" Grid.Column="1" Margin="0,2,0,0">
                    <RadioButton Style="{StaticResource Seg}" GroupName="mode" Tag="MusicSync" Content="Music sync"/>
                    <RadioButton Style="{StaticResource Seg}" GroupName="mode" Tag="Steady" Content="Steady" ToolTip="A calm glow that stays on, even without sound"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- behaviour -->
        <TextBlock Text="BEHAVIOUR" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <CheckBox x:Name="IdleGlow" Style="{StaticResource Switch}" Content="Glow when nothing is playing"/>
                <CheckBox x:Name="ShowLyrics" Style="{StaticResource Switch}" Content="Show lyrics"/>
                <CheckBox x:Name="ShowInCapture" Style="{StaticResource Switch}" Content="Show in screenshots &amp; recordings"/>
                <CheckBox x:Name="AutoStart" Style="{StaticResource Switch}" Content="Start with Windows"/>
            </StackPanel>
        </Border>

        <Button x:Name="Quit" Content="Quit Penumbra" HorizontalAlignment="Left" Cursor="Hand" Foreground="#f0f0f5">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="7" Background="{StaticResource Control}" Padding="12,6">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#4a2a35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </StackPanel>
    </ScrollViewer>
</Window>
