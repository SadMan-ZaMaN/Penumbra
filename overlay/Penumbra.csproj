<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>   <!-- only for the tray icon + color picker -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>   <!-- WPF and WinForms share type names -->
    <AssemblyName>Penumbra</AssemblyName>
    <RootNamespace>Penumbra</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Penumbra.ico</ApplicationIcon>   <!-- the exe's icon: shortcuts, Start menu, taskbar -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct3D 11 for the GPU-drawn glow; the shader is compiled when the app starts -->
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Glow.hlsl" LogicalName="Glow.hlsl" />
    <EmbeddedResource Include="Penumbra.ico" LogicalName="Penumbra.ico" />   <!-- the same icon for the tray -->
  </ItemGroup>

</Project>
